[Unit]
Description=Telepraxis SMS-Ausgangsqueue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telepraxis-sms
Group=telepraxis-sms
UMask=0007
WorkingDirectory=/opt/telepraxis-sms
ExecStart=/usr/bin/php /opt/telepraxis-sms/telepraxis-sms-worker.php --config /etc/telepraxis-sms/worker.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telepraxis-sms

[Install]
WantedBy=multi-user.target
